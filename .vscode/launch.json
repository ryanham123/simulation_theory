{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Build PDF",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_pdf.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "TTS Book To Audio",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/tts_book_to_audio.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
